# Lightweight image for running camera_fusion.run directly on a Raspberry Pi
# under Docker Swarm. Deliberately excludes torch/LightGlue (see
# middleware/Dockerfile for that heavier, desktop-only image) -- this is
# just the core detection pipeline for a single camera.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-opencv \
        v4l-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN python3 -m pip install --break-system-packages --upgrade pip \
    && grep -v -e opencv-python -e torch -e lightglue requirements.txt > req.txt \
    && python3 -m pip install --break-system-packages --no-cache-dir -r req.txt

COPY . /app

CMD ["python3", "-m", "camera_fusion.run", "--config", "configs/front.json", "--duration", "0"]

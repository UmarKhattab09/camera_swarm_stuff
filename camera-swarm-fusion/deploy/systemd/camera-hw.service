[Unit]
Description=Camera Sensor Fusion Hardware Service
After=network.target

[Service]
Type=simple
User=admin
Group=admin
SupplementaryGroups=video
WorkingDirectory=/home/admin/camera_swarm_stuff/camera-swarm-fusion
Environment=CAMERA_SOCKET_PATH=/run/camera-hw/camera.sock
Environment=CAMERA_DEVICE=/dev/video0
ExecStart=/home/admin/camera_swarm_stuff/camera-swarm-fusion/.venv/bin/python -m camera_host
Restart=always
RestartSec=3
RuntimeDirectory=camera-hw
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target

[Unit]
Description=Camera Sensor Fusion Hardware Service
After=network.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video
WorkingDirectory=/opt/camera-sensor-fusion
Environment=CAMERA_SOCKET_PATH=/run/camera-hw/camera.sock
Environment=CAMERA_DEVICE=/dev/video0
ExecStart=/opt/camera-sensor-fusion/.venv/bin/python -m camera_host
Restart=always
RestartSec=3
RuntimeDirectory=camera-hw
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
